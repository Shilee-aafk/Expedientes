<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Plugin de AutoCAD / Civil 3D. Mismo código, dos compilaciones:
      net48          → AutoCAD y Civil 3D 2021–2024 (R24.x)
      net8.0-windows → AutoCAD y Civil 3D 2025–2026 (R25.x)
      net10.0-windows → AutoCAD y Civil 3D 2027 (R26.x)
    Solo usa la API de AutoCAD, así funciona igual en AutoCAD y en Civil 3D.
  -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>ExpedientesSPR</RootNamespace>
    <AssemblyName>ExpedientesSPR</AssemblyName>
    <Version>0.3.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Nucleo\*.cs" Link="Nucleo\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="AutoCAD.NET" Version="24.1.51000" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="26.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" ExcludeAssets="runtime" PrivateAssets="all" />
    <!-- Ventanas (WinForms) sin depender del SDK de escritorio: así también compila fuera de Windows -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
</Project>
